# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ECR_REPO=your-app-repo

# ECS Configuration  
ECS_CLUSTER=arn:aws:ecs:us-east-1:123456789012:cluster/your-cluster
ECS_SERVICE=arn:aws:ecs:us-east-1:123456789012:service/your-cluster/your-service
TASK_FAMILY=your-task-family
CONTAINER_NAME=your-container

# Jenkins Configuration (optional - uses system AWS credentials if not set)
AWS_CREDS_ID=aws-creds